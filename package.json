{
  "name": "pebble-metro",
  "author": "Rafael Borges",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelborges29/pebble-metro.git"
  },
  "version": "0.5.0-snapshot",
  "description": "Small native Lisbon Metro arrivals app for Pebble Time 2 and Pebble Round 2.",
  "scripts": {
    "build": "pebble build --sdk 4.33.1",
    "build:dev": "pebble build --sdk 4.33.1 -- --app-variant=dev",
    "install:dev": "bash tools/install-dev.sh",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project e2e/tsconfig.json",
    "e2e": "npm run typecheck && npm run check && playwright test",
    "assets:screenshots": "npm run typecheck && npm run check && METRO_CAPTURE_ASSETS=1 playwright test --grep 'reopen immediately' --output=test-results/store-capture --reporter=list",
    "check": "node --check src/pkjs/bootstrap.cjs && npm run build"
  },
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "paho-mqtt": "1.1.0"
  },
  "pebble": {
    "displayName": "Metro Lisboa",
    "uuid": "5576168a-8b38-4be1-90e7-343af607c167",
    "projectType": "native",
    "sdkVersion": "3",
    "manifestVersion": 2,
    "enableMultiJS": true,
    "capabilities": [
      "configurable"
    ],
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "api.underlx.com"
          ]
        },
        "reason": "To download Lisbon Metro station and line information from UnderLX.",
        "required": true
      },
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "perturbacoes.pt"
          ]
        },
        "reason": "To receive live Lisbon Metro arrival estimates from UnderLX.",
        "required": true
      }
    ],
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "DATA"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "MENU_ICON",
          "file": "images/menu-icon.png",
          "menuIcon": true
        }
      ]
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "effect": "4.1.3",
    "mqtt-packet": "9.0.2",
    "typescript": "7.0.2"
  }
}
